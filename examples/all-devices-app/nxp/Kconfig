mainmenu "Matter NXP All-Devices App Example"

config NXP_ALL_DEVICES_APP
       bool "Enable NXP All-Devices App mode"
       default n
       help
         When enabled, AppTaskBase::InitServer defers Server::Init until a
         device type is selected via the 'devtype set <type>' CLI command.

source "$(CHIP_ROOT)/config/nxp/chip-cmake-freertos/Kconfig.defaults"
source "$(CHIP_ROOT)/examples/platform/nxp/common/Kconfig"
source "Kconfig.mcuxpresso"
